#!/usr/bin/env python3
"""stdio MCP server: one named tool per bir-headless allow-listed invoke.

Wraps the installed `gpui-agent` CLI. Does not speak the HMAC protocol itself
and does not start the daemon. Filing and submit verbs are not tools.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from typing import Any

DEFAULT_ADDR = "127.0.0.1:17421"
EXPECTED_APP = "bir-desktop"
SERVER_NAME = "bir-mcp"
SERVER_VERSION = "0.1.0"
PROTOCOL_FALLBACK = "2024-11-05"
KNOWN_PROTOCOLS = {
    "2024-11-05",
    "2025-03-26",
    "2025-06-18",
}

# Daemon verbs confirmed in bir-desktop AgentHost::invoke. Not aliases we
# invented. filing.submit / queue / file are intentionally absent.
def _dues_schema() -> dict[str, Any]:
    return {
        "type": "object",
        "properties": {
            "tin": {"type": "string"},
            "q": {"type": "string"},
            "filter": {"type": "string", "enum": ["upcoming", "overdue", "all"]},
            "scope": {"type": "string", "enum": ["profile", "global", "upcoming", "overdue", "all"]},
            "limit": {"type": "integer"},
        },
        "additionalProperties": False,
    }



